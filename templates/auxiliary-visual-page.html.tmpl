<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{PAGE_TITLE}} - Perth BitDevs {{MONTH_LABEL}}</title>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
<script>(function(){try{var s=localStorage.getItem('pbd-theme');var m=window.matchMedia&&window.matchMedia('(prefers-color-scheme: light)');var t=s||(m&&m.matches?'light':'dark');document.documentElement.dataset.theme=t}catch(e){}})();</script>
<link rel="stylesheet" href="/assets/theme.css">
<script src="/assets/theme.js" defer></script>
<style>
:root {
  --bg:#06080d;--sf:#0d1117;--sf2:#151b25;--bd:#1c2432;--bdh:#2a3545;
  --tx:#e2e8f0;--txM:#94a3b8;--txD:#506078;
  --or:#f7931a;--orD:rgba(247,147,26,.10);--orG:rgba(247,147,26,.25);--orB:#b36a0f;
  --bl:#3b82f6;--bld:rgba(59,130,246,.12);--gn:#22c55e;--gnd:rgba(34,197,94,.12);
  --rd:#ef4444;--rdd:rgba(239,68,68,.12);--cy:#06b6d4;--cyd:rgba(6,182,212,.12);
  --pu:#a855f7;--pud:rgba(168,85,247,.12);--yl:#eab308;--yld:rgba(234,179,8,.12);
  --accent:var(--cy);--accent-bg:var(--cyd);--accent-glow:rgba(6,182,212,.18);
}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:var(--tx);font-family:'DM Sans',sans-serif;min-height:100vh;overflow-x:hidden;-webkit-font-smoothing:antialiased}
body::before{content:"";position:fixed;inset:0;background-image:linear-gradient(rgba(6,182,212,.012) 1px,transparent 1px),linear-gradient(90deg,rgba(6,182,212,.012) 1px,transparent 1px);background-size:48px 48px;pointer-events:none;z-index:0}
.wrap{max-width:960px;margin:0 auto;padding:40px 24px 120px;position:relative;z-index:1}
.back{font-family:'JetBrains Mono',monospace;font-size:15px;color:var(--txD);text-decoration:none;display:inline-block;margin-bottom:22px;transition:color .15s}
.back:hover{color:var(--accent)}
.hero{text-align:center;margin-bottom:48px;position:relative}
.hero::before{content:"";position:absolute;top:-80px;left:50%;transform:translateX(-50%);width:620px;height:420px;background:radial-gradient(circle,var(--accent-glow) 0%,transparent 65%);pointer-events:none;filter:blur(40px)}
.hero-badge{display:inline-flex;gap:8px;align-items:center;padding:5px 14px;border:1px solid var(--bd);border-radius:100px;font-family:'JetBrains Mono',monospace;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);margin-bottom:16px;position:relative;z-index:1}
.hero-badge::before{content:"";width:7px;height:7px;background:var(--accent);border-radius:50%}
h1{font-family:'JetBrains Mono',monospace;font-size:clamp(36px,6vw,56px);font-weight:800;letter-spacing:0;line-height:1.15;position:relative;z-index:1}
h1 .hl{background:linear-gradient(135deg,var(--accent) 0%,#67e8f9 50%,var(--accent) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero p{color:var(--txM);font-size:20px;line-height:1.55;max-width:720px;margin:14px auto 0;position:relative;z-index:1}
.section{margin-bottom:56px}
.section-hdr{display:flex;align-items:center;gap:12px;margin-bottom:18px;padding-bottom:10px;border-bottom:2px solid var(--bd)}
.section-num{font-family:'JetBrains Mono',monospace;font-size:15px;font-weight:700;color:var(--bg);background:var(--accent);width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:5px;flex-shrink:0}
.section-title{font-family:'JetBrains Mono',monospace;font-size:22px;font-weight:700;color:#fff}
.canvas{background:var(--sf);border:1px solid var(--bd);border-radius:10px;padding:24px;margin:16px 0;position:relative;overflow:hidden}
.canvas::before{content:"";position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--accent),transparent);opacity:.3}
.canvas-label{font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--txD);letter-spacing:2px;text-transform:uppercase;margin-bottom:14px}
.visual-placeholder{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:14px 0}
.node{border:1px solid var(--bd);background:var(--sf2);border-radius:8px;padding:18px;text-align:center;min-height:116px;display:flex;flex-direction:column;justify-content:center;gap:8px}
.node-title{font-family:'JetBrains Mono',monospace;font-size:17px;font-weight:700;color:var(--accent)}
.node-text{font-size:18px;color:var(--txM);line-height:1.45}
.stepper{display:flex;align-items:center;gap:6px;margin:14px 0;flex-wrap:wrap}
.step-btn,.step-arrow{font-family:'JetBrains Mono',monospace;border:1px solid var(--bd);background:var(--sf);color:var(--txD);border-radius:5px;cursor:pointer;transition:all .15s}
.step-btn{font-size:14px;padding:6px 12px;white-space:nowrap}
.step-arrow{font-size:15px;padding:6px 10px}
.step-btn:hover,.step-arrow:hover{border-color:var(--bdh);color:var(--tx)}
.step-btn[aria-pressed="true"]{border-color:var(--accent);color:var(--accent);background:var(--accent-bg)}
.step-arrow:disabled{opacity:.3;cursor:default}
.narration{background:var(--sf);border:1px solid var(--bd);border-left:3px solid var(--accent);border-radius:0 8px 8px 0;padding:16px 20px;margin:14px 0;font-size:19px;line-height:1.65;min-height:72px;color:var(--txM)}
.narration strong{color:var(--tx)}
.narration code{font-family:'JetBrains Mono',monospace;font-size:17px;color:var(--accent);background:var(--accent-bg);padding:2px 6px;border-radius:4px}
.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:14px 0}
.info-card{background:var(--sf);border:1px solid var(--bd);border-radius:8px;padding:16px 18px}
.info-label{font-family:'JetBrains Mono',monospace;font-size:15px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--accent);margin-bottom:7px}
.info-value{color:var(--txM);font-size:18px;line-height:1.55}
.links{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
.links a{color:#60a5fa;font-family:'JetBrains Mono',monospace;font-size:16px;text-decoration:none}
.links a:hover{text-decoration:underline}
@media(max-width:760px){.visual-placeholder,.info-grid{grid-template-columns:1fr}.wrap{padding:32px 16px 80px}.hero p{font-size:18px}.section-title{font-size:19px}}
</style>
</head>
<body>
<div class="wrap">
  <a class="back" href="/{{MONTH}}/">&larr; Topics</a>

  <header class="hero">
    <div class="hero-badge">{{PAGE_TYPE}}</div>
    <h1><span class="hl">{{PAGE_TITLE}}</span></h1>
    <p>{{PAGE_SUMMARY}}</p>
  </header>

  <section class="section">
    <div class="section-hdr">
      <div class="section-num">1</div>
      <div class="section-title">{{SECTION_TITLE}}</div>
    </div>
    <div class="canvas">
      <div class="canvas-label">Diagram</div>
      <div class="visual-placeholder" id="visual">
        <div class="node"><div class="node-title">{{NODE_A}}</div><div class="node-text">{{NODE_A_TEXT}}</div></div>
        <div class="node"><div class="node-title">{{NODE_B}}</div><div class="node-text">{{NODE_B_TEXT}}</div></div>
        <div class="node"><div class="node-title">{{NODE_C}}</div><div class="node-text">{{NODE_C_TEXT}}</div></div>
      </div>
    </div>

    <div class="stepper" aria-label="Explanation steps">
      <button type="button" class="step-arrow" id="prevStep">&larr;</button>
      <button type="button" class="step-btn" data-step="0">Step 1</button>
      <button type="button" class="step-btn" data-step="1">Step 2</button>
      <button type="button" class="step-btn" data-step="2">Step 3</button>
      <button type="button" class="step-arrow" id="nextStep">&rarr;</button>
    </div>
    <div class="narration" id="narration"></div>
  </section>

  <section class="section">
    <div class="section-hdr">
      <div class="section-num">2</div>
      <div class="section-title">Discussion Hooks</div>
    </div>
    <div class="info-grid">
      <div class="info-card"><div class="info-label">QUESTION</div><div class="info-value">{{DISCUSSION_PROMPT}}</div></div>
      <div class="info-card"><div class="info-label">VERIFY</div><div class="info-value">{{CLAIM_TO_VERIFY}}</div></div>
    </div>
    <div class="links">
      <a href="{{SOURCE_URL}}" target="_blank" rel="noopener">{{SOURCE_LABEL}}</a>
    </div>
  </section>
</div>

<script>
const monthHref = '/{{MONTH}}/';
const steps = [
  '<strong>{{STEP_1_TITLE}}</strong>: {{STEP_1_TEXT}}',
  '<strong>{{STEP_2_TITLE}}</strong>: {{STEP_2_TEXT}}',
  '<strong>{{STEP_3_TITLE}}</strong>: {{STEP_3_TEXT}}'
];
const stepButtons = Array.from(document.querySelectorAll('[data-step]'));
const prevStep = document.getElementById('prevStep');
const nextStep = document.getElementById('nextStep');
const narration = document.getElementById('narration');
let stepIndex = 0;

function renderStep(index) {
  stepIndex = Math.max(0, Math.min(steps.length - 1, index));
  narration.innerHTML = steps[stepIndex];
  stepButtons.forEach(button => {
    const active = Number(button.dataset.step) === stepIndex;
    button.setAttribute('aria-pressed', String(active));
  });
  prevStep.disabled = stepIndex === 0;
  nextStep.disabled = stepIndex === steps.length - 1;
}

stepButtons.forEach(button => button.addEventListener('click', () => renderStep(Number(button.dataset.step))));
prevStep.addEventListener('click', () => renderStep(stepIndex - 1));
nextStep.addEventListener('click', () => renderStep(stepIndex + 1));
document.addEventListener('keydown', event => {
  if (event.key === 'ArrowRight') renderStep(stepIndex + 1);
  if (event.key === 'ArrowLeft') renderStep(stepIndex - 1);
  if (event.key === 'Escape') window.location.href = monthHref;
});

renderStep(0);
</script>
</body>
</html>
