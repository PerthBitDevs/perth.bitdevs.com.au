<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{TOPIC_TITLE}} - Perth BitDevs {{MONTH_LABEL}}</title>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
<script>(function(){try{var s=localStorage.getItem('pbd-theme');var m=window.matchMedia&&window.matchMedia('(prefers-color-scheme: light)');var t=s||(m&&m.matches?'light':'dark');document.documentElement.dataset.theme=t}catch(e){}})();</script>
<link rel="stylesheet" href="/assets/theme.css">
<link rel="stylesheet" href="/assets/slide-chrome.css">
<script src="/assets/theme.js" defer></script>
<script src="/assets/slides.js" defer></script>
<style>
:root {
  --bg:#06080d;--sf:#0d1117;--sf2:#151b25;--bd:#1c2432;--bdh:#2a3545;
  --tx:#e2e8f0;--txM:#94a3b8;--txD:#506078;
  --or:#f7931a;--orD:rgba(247,147,26,.10);--orG:rgba(247,147,26,.25);--orB:#b36a0f;
  --bl:#3b82f6;--bld:rgba(59,130,246,.12);
  --gn:#22c55e;--gnd:rgba(34,197,94,.12);
  --rd:#ef4444;--rdd:rgba(239,68,68,.12);
  --cy:#06b6d4;--cyd:rgba(6,182,212,.12);
  --pu:#a855f7;--pud:rgba(168,85,247,.12);
  --pk:#ec4899;--pkd:rgba(236,72,153,.12);
  --yl:#eab308;--yld:rgba(234,179,8,.12);
  --tl:#14b8a6;--tld:rgba(20,184,166,.12);
  --accent:var(--or);--accent-bg:var(--orD);--accent-glow:var(--orG);--accent-border:var(--orB);
}
*{margin:0;padding:0;box-sizing:border-box}
body{
  background:var(--bg);color:var(--tx);font-family:'DM Sans',sans-serif;
  min-height:100vh;display:flex;flex-direction:column;overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}
body::before{
  content:"";position:fixed;inset:0;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.025'/%3E%3C/svg%3E");
  pointer-events:none;z-index:1000;
}
.glow{position:fixed;top:-160px;left:50%;transform:translateX(-50%);width:760px;height:430px;background:radial-gradient(ellipse,var(--accent-glow),transparent 70%);filter:blur(90px);opacity:.65;pointer-events:none}
/*
 * The slide-deck chrome (.header, .badge, .dots, .branding, .content,
 * .slide-inner, .slide, h2.slide-title, .subtitle, .hero, .grid, .card and
 * variants, .links, .disclosure, .footer-nav, .nav-btn, .nav-info, plus the
 * @media responsive rules) lives in /assets/slide-chrome.css. Add per-topic
 * bespoke components below as needed; they'll override the shared rules.
 */
</style>
</head>
<body>
<div class="glow"></div>
<div class="header">
  <div class="badge-group">
    <div class="badge">{{CATEGORY_LABEL}}</div>
    <div class="update-tag">{{STATUS_OR_SOURCE}}</div>
  </div>
  <div class="dots" id="dots" aria-label="Slide navigation"></div>
  <a class="branding" href="/{{MONTH}}/">&larr; Topics</a>
</div>

<div class="content">
<div class="slide-inner">

<div class="slide" data-name="Why Now">
  <h2 class="slide-title">{{TOPIC_TITLE}}</h2>
  <p class="subtitle">{{ONE_SENTENCE_CONTEXT}}</p>
  <div class="hero">
    <div class="hero-kicker">Takeaway</div>
    <div class="hero-text">{{MAIN_TAKEAWAY}}</div>
  </div>
  <div class="grid">
    <div class="card"><div class="card-label">CONTEXT</div><div class="card-text">{{CARD_TEXT}}</div></div>
    <div class="card bl"><div class="card-label">WHY NOW</div><div class="card-text">{{CARD_TEXT}}</div></div>
  </div>
  <div class="links">
    <a href="{{SOURCE_URL}}" target="_blank" rel="noopener">{{SOURCE_LABEL}}</a>
  </div>
</div>

<div class="slide" data-name="Mechanics">
  <h2 class="slide-title">How It Works</h2>
  <p class="subtitle">{{MECHANICS_SUBTITLE}}</p>
  <div class="grid">
    <div class="card gn"><div class="card-label">STEP 1</div><div class="card-text">{{CARD_TEXT}}</div></div>
    <div class="card cy"><div class="card-label">STEP 2</div><div class="card-text">{{CARD_TEXT}}</div></div>
    <div class="card pu"><div class="card-label">STEP 3</div><div class="card-text">{{CARD_TEXT}}</div></div>
    <div class="card yl"><div class="card-label">TRADEOFF</div><div class="card-text">{{CARD_TEXT}}</div></div>
  </div>
</div>

<div class="slide" data-name="Discussion">
  <h2 class="slide-title">Discussion Prompts</h2>
  <p class="subtitle">{{DISCUSSION_SUBTITLE}}</p>
  <div class="grid">
    <div class="card"><div class="card-label">QUESTION</div><div class="card-text">{{PROMPT_TEXT}}</div></div>
    <div class="card rd"><div class="card-label">RISK</div><div class="card-text">{{PROMPT_TEXT}}</div></div>
  </div>
  <div class="disclosure">
    <button type="button" class="disclosure-trigger" aria-expanded="false" aria-controls="detail-1" data-disclosure-target="detail-1">
      Optional deeper detail
    </button>
    <div class="disclosure-body" id="detail-1" hidden>
      {{DETAIL_TEXT}}
    </div>
  </div>
</div>

</div>
</div>

<div class="footer-nav">
  <button type="button" class="nav-btn" id="prevBtn">&larr; Prev</button>
  <div class="nav-info" id="navInfo"></div>
  <button type="button" class="nav-btn next" id="nextBtn">Next &rarr;</button>
</div>
<!--
  Slide runtime (keyboard navigation, dot rendering, prev/next, disclosure
  toggling, Escape → back to month hub) is provided by /assets/slides.js.
  Add per-topic bespoke <script> blocks below if needed.
-->
</body>
</html>
