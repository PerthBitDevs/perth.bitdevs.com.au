<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{TOPIC_TITLE}} - Perth BitDevs {{MONTH_LABEL}}</title>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
<style>
:root {
  --bg:#06080d;--sf:#0d1117;--sf2:#151b25;--bd:#1c2432;--bdh:#2a3545;
  --tx:#e2e8f0;--txM:#94a3b8;--txD:#506078;
  --or:#f7931a;--orD:rgba(247,147,26,.10);--orG:rgba(247,147,26,.25);--orB:#b36a0f;
  --bl:#3b82f6;--bld:rgba(59,130,246,.12);
  --gn:#22c55e;--gnd:rgba(34,197,94,.12);
  --rd:#ef4444;--rdd:rgba(239,68,68,.12);
  --cy:#06b6d4;--cyd:rgba(6,182,212,.12);
  --pu:#a855f7;--pud:rgba(168,85,247,.12);
  --pk:#ec4899;--pkd:rgba(236,72,153,.12);
  --yl:#eab308;--yld:rgba(234,179,8,.12);
  --tl:#14b8a6;--tld:rgba(20,184,166,.12);
  --accent:var(--or);--accent-bg:var(--orD);--accent-glow:var(--orG);--accent-border:var(--orB);
}
*{margin:0;padding:0;box-sizing:border-box}
body{
  background:var(--bg);color:var(--tx);font-family:'DM Sans',sans-serif;
  min-height:100vh;display:flex;flex-direction:column;overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}
body::before{
  content:"";position:fixed;inset:0;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.025'/%3E%3C/svg%3E");
  pointer-events:none;z-index:1000;
}
.glow{position:fixed;top:-160px;left:50%;transform:translateX(-50%);width:760px;height:430px;background:radial-gradient(ellipse,var(--accent-glow),transparent 70%);filter:blur(90px);opacity:.65;pointer-events:none}
.header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px;border-bottom:1px solid var(--bd);flex-shrink:0;position:relative;z-index:10}
.badge-group{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.badge,.update-tag{font-family:'JetBrains Mono',monospace;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
.badge{padding:3px 12px;background:var(--accent-bg);border:1px solid var(--accent);border-radius:16px;color:var(--accent);font-size:14px}
.update-tag{padding:2px 8px;background:var(--sf2);border:1px solid var(--bdh);border-radius:4px;color:var(--txM);font-size:13px}
.dots{display:flex;gap:4px;flex-wrap:wrap;justify-content:center}
.dot{min-width:34px;padding:4px 9px;border:1px solid var(--bd);border-radius:4px;background:transparent;color:var(--txD);font-family:'JetBrains Mono',monospace;font-size:14px;font-weight:500;cursor:pointer;transition:all .15s}
.dot:hover{border-color:var(--bdh);color:var(--txM)}
.dot.on{border-color:var(--accent);background:var(--accent-bg);color:var(--accent);font-weight:700}
.branding{color:var(--txD);font-family:'JetBrains Mono',monospace;font-size:14px;text-decoration:none;transition:color .15s;white-space:nowrap}
.branding:hover{color:var(--accent)}
.content{flex:1;display:flex;flex-direction:column;justify-content:center;padding:16px 20px;overflow:auto;position:relative;z-index:1}
.slide-inner{max-width:960px;margin:0 auto;width:100%}
.slide{display:none}.slide.active{display:block}
h2.slide-title{font-family:'JetBrains Mono',monospace;font-size:36px;font-weight:800;letter-spacing:0;text-align:center;line-height:1.18;margin-bottom:14px;background:linear-gradient(135deg,var(--accent),#fbbf24);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.subtitle{text-align:center;color:var(--txM);font-size:20px;margin-top:-6px;margin-bottom:16px;line-height:1.5}
.hero{border:1px solid var(--accent-border);background:linear-gradient(135deg,var(--accent-bg),rgba(59,130,246,.08));border-radius:8px;padding:24px 28px;margin-bottom:14px}
.hero-kicker,.card-label{font-family:'JetBrains Mono',monospace;font-weight:700;letter-spacing:.06em}
.hero-kicker{font-size:17px;color:var(--accent);margin-bottom:8px;text-transform:uppercase}
.hero-text{font-size:26px;line-height:1.45;color:var(--tx)}
.hero-text strong{color:#fff}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
.card{background:var(--sf2);border:1px solid var(--bd);border-radius:8px;padding:15px 18px;position:relative}
.card::before{content:"";position:absolute;top:0;left:0;width:3px;height:100%;border-radius:8px 0 0 8px;background:var(--accent);opacity:.7}
.card.bl::before{background:var(--bl)}.card.gn::before{background:var(--gn)}.card.rd::before{background:var(--rd)}.card.cy::before{background:var(--cy)}.card.pu::before{background:var(--pu)}.card.pk::before{background:var(--pk)}.card.yl::before{background:var(--yl)}.card.tl::before{background:var(--tl)}
.card-label{font-size:18px;margin-bottom:8px;color:var(--accent)}
.card.bl .card-label{color:var(--bl)}.card.gn .card-label{color:var(--gn)}.card.rd .card-label{color:var(--rd)}.card.cy .card-label{color:var(--cy)}.card.pu .card-label{color:var(--pu)}.card.pk .card-label{color:var(--pk)}.card.yl .card-label{color:var(--yl)}.card.tl .card-label{color:var(--tl)}
.card-text{color:var(--txM);font-size:20px;line-height:1.55}
.card-text strong{color:var(--tx)}
.card-text code{font-family:'JetBrains Mono',monospace;font-size:17px;color:var(--or);background:var(--orD);padding:2px 6px;border-radius:4px}
.links{display:flex;flex-wrap:wrap;gap:10px;margin-top:8px}
.links a{color:#60a5fa;font-family:'JetBrains Mono',monospace;font-size:17px;text-decoration:none;opacity:.9}
.links a:hover{opacity:1;text-decoration:underline}
.disclosure{border:1px solid var(--bd);border-radius:8px;background:var(--sf);margin-top:12px;overflow:hidden}
.disclosure-trigger{width:100%;border:0;background:transparent;color:var(--tx);font-family:'JetBrains Mono',monospace;font-size:17px;font-weight:700;text-align:left;padding:13px 16px;cursor:pointer;display:flex;justify-content:space-between;gap:12px}
.disclosure-trigger:hover{background:var(--sf2)}
.disclosure-trigger::after{content:"+";color:var(--accent)}
.disclosure-trigger[aria-expanded="true"]::after{content:"-"}
.disclosure-body{border-top:1px solid var(--bd);padding:14px 16px;color:var(--txM);font-size:19px;line-height:1.55}
.footer-nav{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:10px 20px;border-top:1px solid var(--bd);flex-shrink:0;position:relative;z-index:10}
.nav-btn{min-width:108px;padding:6px 18px;border:1px solid var(--bdh);border-radius:6px;background:transparent;color:var(--txM);font-family:'JetBrains Mono',monospace;font-size:17px;cursor:pointer;transition:all .15s}
.nav-btn:disabled{opacity:.4;cursor:default}
.nav-btn.next{border-color:var(--accent);background:var(--accent-bg);color:var(--accent)}
.nav-btn.next:disabled{border-color:var(--bd);background:transparent;color:var(--txD)}
.nav-info{color:var(--txD);font-family:'JetBrains Mono',monospace;font-size:16px;text-align:center}
@media(max-width:760px){.grid{grid-template-columns:1fr}.header{flex-wrap:wrap}.dots{order:3;width:100%}.content{justify-content:flex-start}h2.slide-title{font-size:30px}.hero-text{font-size:22px}.footer-nav{padding:10px 12px}.nav-btn{min-width:auto}}
</style>
</head>
<body>
<div class="glow"></div>
<div class="header">
  <div class="badge-group">
    <div class="badge">{{CATEGORY_LABEL}}</div>
    <div class="update-tag">{{STATUS_OR_SOURCE}}</div>
  </div>
  <div class="dots" id="dots" aria-label="Slide navigation"></div>
  <a class="branding" href="/{{MONTH}}/">&larr; Topics</a>
</div>

<div class="content">
<div class="slide-inner">

<div class="slide" data-name="Why Now">
  <h2 class="slide-title">{{TOPIC_TITLE}}</h2>
  <p class="subtitle">{{ONE_SENTENCE_CONTEXT}}</p>
  <div class="hero">
    <div class="hero-kicker">Takeaway</div>
    <div class="hero-text">{{MAIN_TAKEAWAY}}</div>
  </div>
  <div class="grid">
    <div class="card"><div class="card-label">CONTEXT</div><div class="card-text">{{CARD_TEXT}}</div></div>
    <div class="card bl"><div class="card-label">WHY NOW</div><div class="card-text">{{CARD_TEXT}}</div></div>
  </div>
  <div class="links">
    <a href="{{SOURCE_URL}}" target="_blank" rel="noopener">{{SOURCE_LABEL}}</a>
  </div>
</div>

<div class="slide" data-name="Mechanics">
  <h2 class="slide-title">How It Works</h2>
  <p class="subtitle">{{MECHANICS_SUBTITLE}}</p>
  <div class="grid">
    <div class="card gn"><div class="card-label">STEP 1</div><div class="card-text">{{CARD_TEXT}}</div></div>
    <div class="card cy"><div class="card-label">STEP 2</div><div class="card-text">{{CARD_TEXT}}</div></div>
    <div class="card pu"><div class="card-label">STEP 3</div><div class="card-text">{{CARD_TEXT}}</div></div>
    <div class="card yl"><div class="card-label">TRADEOFF</div><div class="card-text">{{CARD_TEXT}}</div></div>
  </div>
</div>

<div class="slide" data-name="Discussion">
  <h2 class="slide-title">Discussion Prompts</h2>
  <p class="subtitle">{{DISCUSSION_SUBTITLE}}</p>
  <div class="grid">
    <div class="card"><div class="card-label">QUESTION</div><div class="card-text">{{PROMPT_TEXT}}</div></div>
    <div class="card rd"><div class="card-label">RISK</div><div class="card-text">{{PROMPT_TEXT}}</div></div>
  </div>
  <div class="disclosure">
    <button type="button" class="disclosure-trigger" aria-expanded="false" aria-controls="detail-1" data-disclosure-target="detail-1">
      Optional deeper detail
    </button>
    <div class="disclosure-body" id="detail-1" hidden>
      {{DETAIL_TEXT}}
    </div>
  </div>
</div>

</div>
</div>

<div class="footer-nav">
  <button type="button" class="nav-btn" id="prevBtn">&larr; Prev</button>
  <div class="nav-info" id="navInfo"></div>
  <button type="button" class="nav-btn next" id="nextBtn">Next &rarr;</button>
</div>

<script>
const monthHref = '/{{MONTH}}/';
const slides = Array.from(document.querySelectorAll('.slide'));
const names = slides.map(slide => slide.dataset.name || 'Slide');
const dots = document.getElementById('dots');
const navInfo = document.getElementById('navInfo');
const prevBtn = document.getElementById('prevBtn');
const nextBtn = document.getElementById('nextBtn');
let cur = 0;

function goTo(index) {
  cur = Math.max(0, Math.min(slides.length - 1, index));
  render();
}

function go(delta) {
  goTo(cur + delta);
}

function render() {
  slides.forEach((slide, index) => slide.classList.toggle('active', index === cur));
  dots.replaceChildren();
  names.forEach((name, index) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = `dot${index === cur ? ' on' : ''}`;
    button.textContent = String(index + 1);
    button.setAttribute('aria-label', `Go to slide ${index + 1}: ${name}`);
    if (index === cur) button.setAttribute('aria-current', 'step');
    button.addEventListener('click', () => goTo(index));
    dots.append(button);
  });
  navInfo.textContent = `${names[cur]} - ${cur + 1} / ${slides.length}`;
  prevBtn.disabled = cur === 0;
  nextBtn.disabled = cur === slides.length - 1;
  nextBtn.className = cur === slides.length - 1 ? 'nav-btn' : 'nav-btn next';
}

document.querySelectorAll('[data-disclosure-target]').forEach(button => {
  const panel = document.getElementById(button.dataset.disclosureTarget);
  if (!panel) return;
  button.addEventListener('click', () => {
    const expanded = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!expanded));
    panel.hidden = expanded;
  });
});

prevBtn.addEventListener('click', () => go(-1));
nextBtn.addEventListener('click', () => go(1));
document.addEventListener('keydown', event => {
  if (event.key === 'ArrowRight') go(1);
  if (event.key === 'ArrowLeft') go(-1);
  if (event.key === 'Escape') window.location.href = monthHref;
});

render();
</script>
</body>
</html>
