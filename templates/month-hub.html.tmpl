<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Perth BitDevs - {{MONTH_LABEL}}</title>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
<script>(function(){try{var s=localStorage.getItem('pbd-theme');var m=window.matchMedia&&window.matchMedia('(prefers-color-scheme: light)');var t=s||(m&&m.matches?'light':'dark');document.documentElement.dataset.theme=t}catch(e){}})();</script>
<link rel="stylesheet" href="/assets/theme.css">
<script src="/assets/theme.js" defer></script>
<style>
:root{--bg:#06080d;--sf:#0d1117;--sf2:#151b25;--bd:#1c2432;--bdh:#2a3545;--tx:#e2e8f0;--txM:#94a3b8;--txD:#506078;--or:#f7931a;--orD:rgba(247,147,26,.10);--orG:rgba(247,147,26,.25);--orB:#b36a0f;--bl:#3b82f6;--bld:rgba(59,130,246,.12);--gn:#22c55e;--gnd:rgba(34,197,94,.12);--rd:#ef4444;--rdd:rgba(239,68,68,.12);--cy:#06b6d4;--cyd:rgba(6,182,212,.12);--pu:#a855f7;--pud:rgba(168,85,247,.12);--pk:#ec4899;--pkd:rgba(236,72,153,.12);--yl:#eab308;--yld:rgba(234,179,8,.12);--tl:#14b8a6;--tld:rgba(20,184,166,.12)}

*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:var(--tx);font-family:'DM Sans',sans-serif;min-height:100vh;-webkit-font-smoothing:antialiased}
body::before{content:"";position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.025'/%3E%3C/svg%3E");pointer-events:none;z-index:1000}
.glow{position:fixed;top:-180px;left:50%;transform:translateX(-50%);width:700px;height:400px;background:radial-gradient(ellipse at center,var(--orG) 0%,transparent 70%);opacity:.4;pointer-events:none;filter:blur(80px)}
.shell{max-width:1080px;margin:0 auto;padding:52px 24px 100px;position:relative}
.back{font-family:'JetBrains Mono',monospace;font-size:17px;color:var(--txD);text-decoration:none;display:inline-block;margin-bottom:24px;transition:color .2s}
.back:hover{color:var(--or)}
header{text-align:center;margin-bottom:48px}
.badge{display:inline-block;padding:5px 16px;border:1px solid var(--orB);border-radius:20px;background:var(--orD);color:var(--or);font-family:'JetBrains Mono',monospace;font-size:17px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-bottom:18px}
h1{font-family:'JetBrains Mono',monospace;font-size:clamp(40px,6vw,60px);font-weight:800;letter-spacing:0;line-height:1.15;margin-bottom:10px;background:linear-gradient(135deg,#f7931a 0%,#fbbf24 50%,#f7931a 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.subtitle{color:var(--txD);font-size:21px;font-family:'JetBrains Mono',monospace}
.note{background:rgba(247,147,26,.08);border:1px solid rgba(247,147,26,.25);border-radius:10px;padding:14px 18px;margin-bottom:32px;font-size:20px;color:var(--txM);line-height:1.6}
.note strong{color:var(--or);font-family:'JetBrains Mono',monospace;font-size:17px;letter-spacing:.06em}
.divider{height:1px;background:linear-gradient(90deg,transparent 0%,var(--bd) 30%,var(--bd) 70%,transparent 100%);margin-bottom:32px}
.section-label{font-family:'JetBrains Mono',monospace;font-size:17px;font-weight:700;color:var(--txD);letter-spacing:.14em;text-transform:uppercase;margin-bottom:16px;padding-left:2px}
.cards{display:flex;flex-direction:column;gap:12px;margin-bottom:40px}
a.card{display:block;text-decoration:none;background:var(--sf);border:1px solid var(--bd);border-radius:12px;padding:20px 22px;transition:all .2s ease;position:relative;overflow:hidden}
a.card::before{content:"";position:absolute;top:0;left:0;width:3px;height:100%;border-radius:12px 0 0 12px;transition:opacity .2s ease;opacity:.6}
a.card:hover{border-color:var(--bdh);background:var(--sf2);transform:translateY(-1px);box-shadow:0 4px 24px rgba(0,0,0,.3)}
a.card:hover::before{opacity:1}
.card-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:7px;gap:8px}
.card-tags{display:flex;gap:6px;flex-wrap:wrap}
.card-tag{font-family:'JetBrains Mono',monospace;font-size:14px;font-weight:700;letter-spacing:.06em;padding:3px 9px;border-radius:10px;text-transform:uppercase;white-space:nowrap}
.card-arrow{font-family:'JetBrains Mono',monospace;font-size:24px;color:var(--txD);transition:all .2s ease;flex-shrink:0}
a.card:hover .card-arrow{color:var(--or);transform:translateX(3px)}
.card-title{font-family:'JetBrains Mono',monospace;font-size:24px;font-weight:700;color:var(--tx);margin-bottom:5px;letter-spacing:0;line-height:1.35}
.card-desc{color:var(--txM);font-size:20px;line-height:1.55}
.card-meta{display:flex;gap:12px;margin-top:10px;flex-wrap:wrap}
.card-meta-item{font-family:'JetBrains Mono',monospace;font-size:16px;color:var(--txD);display:flex;align-items:center;gap:5px}
.card-meta-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0}
.card--or::before{background:var(--or)}.card--or .card-tag{color:var(--or);background:var(--orD)}
.card--bl::before{background:var(--bl)}.card--bl .card-tag{color:var(--bl);background:var(--bld)}
.card--gn::before{background:var(--gn)}.card--gn .card-tag{color:var(--gn);background:var(--gnd)}
.card--cy::before{background:var(--cy)}.card--cy .card-tag{color:var(--cy);background:var(--cyd)}
.card--pu::before{background:var(--pu)}.card--pu .card-tag{color:var(--pu);background:var(--pud)}
footer{text-align:center;padding-top:20px;border-top:1px solid var(--bd);margin-top:16px}
footer p{font-family:'JetBrains Mono',monospace;font-size:17px;color:var(--txD);line-height:1.8}
footer a{color:var(--or);text-decoration:none}footer a:hover{text-decoration:underline}
@media(max-width:480px){.shell{padding:36px 16px 60px}a.card{padding:16px}.card-title{font-size:21px}.badge{font-size:14px}}
</style>
</head>
<body>
<div class="glow"></div>
<div class="shell">
  <a class="back" href="/">&larr; All Events</a>

  <header>
    <div class="badge">{{CONTENT_STATUS}}</div>
    <h1>Perth BitDevs</h1>
    <div class="subtitle">{{DATE_LABEL}} &middot; {{TIME_LABEL}} &middot; {{VENUE_LABEL}}</div>
  </header>

  <div class="note">
    <strong>NOTE</strong>&ensp;{{OPTIONAL_STATUS_NOTE}}
  </div>

  <div class="divider"></div>
  <div class="section-label">{{MONTH_LABEL}} Topics</div>
  <div class="cards">
    <a class="card card--or" href="{{TOPIC_FILE}}">
      <div class="card-top">
        <div class="card-tags">
          <span class="card-tag">{{TAG}}</span>
          <span class="card-tag">{{TAG}}</span>
        </div>
        <span class="card-arrow">&rarr;</span>
      </div>
      <div class="card-title">{{TOPIC_TITLE}}</div>
      <div class="card-desc">{{TOPIC_SUMMARY}}</div>
      <div class="card-meta">
        <span class="card-meta-item"><span class="card-meta-dot" style="background:var(--or)"></span>{{SLIDE_COUNT}} slides</span>
        <span class="card-meta-item"><span class="card-meta-dot" style="background:var(--bl)"></span>{{SOURCE_LABEL}}</span>
      </div>
    </a>
  </div>

  <footer>
    <p>
      Perth BitDevs &middot; {{MONTH_LABEL}}<br>
      <a href="{{GITHUB_ISSUE_URL}}" target="_blank" rel="noopener">GitHub Issue #{{ISSUE_NUMBER}}</a>
    </p>
  </footer>
</div>

</body>
</html>
